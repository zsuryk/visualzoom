{
  "manifest_version": 3,
  "name": "Visual Zoom",
  "version": "1.0.0",
  "description": "Zoom a page by scaling its rendered pixels, not by reflowing the layout.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Visual Zoom",
    "default_popup": "popup.html",
    "default_icon": "icon-48.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
