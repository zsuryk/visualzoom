{
  "manifest_version": 3,
  "name": "Visual Zoom",
  "version": "0.1.0",
  "description": "Zoom a page by scaling its rendered pixels, not by reflowing the layout.",
  "browser_specific_settings": {
    "gecko": {
      "id": "visual-zoom@example.local"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Visual Zoom",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
