{
  "manifest_version": 3,
  "name": "Visual Zoom",
  "version": "1.0.1",
  "description": "Zoom a page by scaling its rendered pixels, not by reflowing the layout.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{83bfea40-bffd-4443-92d8-30e4bff180fe}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Visual Zoom",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
